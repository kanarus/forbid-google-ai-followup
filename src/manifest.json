{
  "manifest_version": 3,
  "name": "Forbid Google AI Followup",
  "version": "0.6.9",
  "description": "Forbids followup at the end of AI overview in Google search.",
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*"],
      "js": ["main.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "forbid-google-ai-followup@kanarus.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
