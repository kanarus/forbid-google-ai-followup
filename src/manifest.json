{
  "manifest_version": 3,
  "author": "kanarus",
  "name": "Forbid Google AI Followup",
  "version": "0.6.11",
  "description": "Forbids followup at the end of AI overview in Google search.",
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*"],
      "js": ["main.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "forbid-google-ai-followup@kanarus.dev",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    },
    "gecko_android": {}
  }
}
